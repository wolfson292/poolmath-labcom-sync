# Copy to .env and fill in. Docker Compose passes these to the container, which maps
# POOLSYNC_Section__Key onto its configuration.

# --- LabCOM -------------------------------------------------------------------
# Token from https://labcom.cloud/pages/user-setting
POOLSYNC_LabCom__ApiToken=

# --- Pool Math ----------------------------------------------------------------
# Pool Math has no API key. Sign in with the Trouble Free Pool forum username
# (not the email address) and password:
POOLSYNC_PoolMath__Username=
POOLSYNC_PoolMath__Password=

# ...or, to keep the password off the NUC, run `dotnet run -- print-token` once on a
# trusted machine and paste the result here instead, leaving the two above blank:
#POOLSYNC_PoolMath__UserId=
#POOLSYNC_PoolMath__AuthToken=

# --- Sync ---------------------------------------------------------------------
# Leave DryRun=true until the logs show the test logs you expect.
# Host port for /health and /status. Change it if 8080 is already in use.
POOLSYNC_HTTP_PORT=8080
# Docker network of the reverse proxy (must already exist).
POOLSYNC_PROXY_NETWORK=home

POOLSYNC_Sync__DryRun=true
POOLSYNC_Sync__DatabasePath=/data/poolsync.db

# Pool Math: needed only to import history and, optionally, to mirror new tests.
POOLSYNC_PoolMath__Enabled=true
POOLSYNC_PoolMath__WriteLogs=false
POOLSYNC_Sync__Interval=00:15:00
POOLSYNC_Sync__InitialBackfill=7.00:00:00

# --- Water bodies -------------------------------------------------------------
# Get the ids from `list-pools` and `list-accounts`, then pair them up per index.
POOLSYNC_WaterBodies__0__Name=
POOLSYNC_WaterBodies__0__LabComAccountId=
POOLSYNC_WaterBodies__0__PoolMathPoolId=
POOLSYNC_WaterBodies__0__Surface=Plaster

POOLSYNC_WaterBodies__1__Name=
POOLSYNC_WaterBodies__1__LabComAccountId=
POOLSYNC_WaterBodies__1__PoolMathPoolId=
POOLSYNC_WaterBodies__1__Surface=Plaster

POOLSYNC_WaterBodies__2__Name=
POOLSYNC_WaterBodies__2__LabComAccountId=
POOLSYNC_WaterBodies__2__PoolMathPoolId=
POOLSYNC_WaterBodies__2__Surface=Plaster

# --- Home Assistant -------------------------------------------------------------
# Where the pool controllers report. Instance 0 also gets alerts and published readings.
POOLSYNC_HomeAssistant__0__Url=
POOLSYNC_HomeAssistant__0__Token=
POOLSYNC_HomeAssistant__0__Notify=notify.all_devices
POOLSYNC_HomeAssistant__0__Publish=true
POOLSYNC_HomeAssistant__1__Url=
POOLSYNC_HomeAssistant__1__Token=
# Per water body: which instance its controller is on, and the ESPHome device name in entity ids.
POOLSYNC_WaterBodies__0__Controller__HomeAssistant=0
POOLSYNC_WaterBodies__0__Controller__Device=

# --- Dosing advice -------------------------------------------------------------
# Strengths of the products on hand. 14.5 for half-strength muriatic acid.
POOLSYNC_Balance__ChlorinePercent=10
POOLSYNC_Balance__AcidPercent=31.45
